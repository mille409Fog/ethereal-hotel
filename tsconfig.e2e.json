/* Playwright specs and config. Kept out of tsconfig.app.json so browser-test
   types never leak into the shipped bundle's type environment. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/e2e",
    "types": ["node"]
  },
  "include": ["e2e/**/*.ts", "playwright.config.ts"]
}
