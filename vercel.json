{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/ethereal-hotel/browser",
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{node_modules/**,dist/**,src/**,e2e/**,public/**,coverage/**,test-results/**,playwright-report/**,.angular/**,docs/**,scripts/**,backend/venv/**,backend/tests/**,backend/alembic/**,**/*.db}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/dashboard", "destination": "/dashboard/index.html" },
    { "source": "/booking", "destination": "/booking/index.html" },
    { "source": "/work", "destination": "/work/index.html" },
    { "source": "/writing", "destination": "/writing/index.html" },
    { "source": "/gallery", "destination": "/gallery/index.html" },
    { "source": "/aesthetic", "destination": "/aesthetic/index.html" },
    { "source": "/murmuration", "destination": "/murmuration/index.html" },
    { "source": "/wanderquest", "destination": "/wanderquest/index.html" },
    { "source": "/aubade/reader", "destination": "/aubade/reader/index.html" },
    { "source": "/aubade", "destination": "/aubade/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
