{
  // Editor settings
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.trimAutoWhitespace": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.eol": "\n",

  // ESLint settings
  "eslint.enable": true,
  "eslint.validate": ["typescript", "html"],
  "eslint.format.enable": true,

  // TypeScript settings
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // Python settings
  // The backend is a self-contained package rooted at ./backend and is run
  // from there (e.g. `from db import ...`). Add it to Pylance's search path
  // so those imports resolve when the workspace is opened at the repo root.
  "python.analysis.extraPaths": ["./backend"],
  // The backend's dependencies live in ./backend/venv. Default Pylance to that
  // interpreter so third-party imports (fastapi, pydantic, sqlalchemy) resolve.
  // Note: this only applies when no interpreter has been explicitly selected
  // for the workspace — if imports still fail, use the interpreter picker.
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/venv/Scripts/python.exe",

  // File associations
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  // `source.organizeImports` above deletes imports it cannot see a use for,
  // and it runs on every explicit save. In a TypeScript file mid-edit that is
  // usually right. In the plain-ESM scripts under `scripts/` it is not: those
  // get written top-down, so the `node:` imports at the top have no usages yet
  // and Ctrl+S silently removes the lines you just typed. Formatting and
  // ESLint's fixAll still apply — this turns off only the import surgery.
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never"
    }
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "angular.enable-strict-mode-prompt": false
}
