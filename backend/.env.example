# Backend Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=True

# Database (defaults to a local SQLite file if unset)
# DATABASE_URL=sqlite:///./ethereal_hotel.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/ethereal_hotel

# CORS Settings
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173

# Logging: CRITICAL | ERROR | WARNING | INFO | DEBUG (default INFO).
# An unrecognised value falls back to INFO rather than failing startup.
LOG_LEVEL=INFO

# How often the shared broadcaster pushes a metrics snapshot to every
# connected WebSocket client, in seconds. One query per tick regardless of
# how many clients are connected.
BROADCAST_INTERVAL_SECONDS=2

# API Settings
API_PREFIX=/api
DEBUG=True
