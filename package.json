{
  "name": "ethereal-hotel",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:backend": "cd backend && python main.py",
    "build": "ng build && node scripts/emit-route-meta.mjs",
    "gen:social": "node scripts/gen-social-assets.mjs",
    "capture:stream": "node scripts/capture-stream.mjs",
    "resume:pdf": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/render-resume.mjs",
    "resume:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/render-resume.mjs --check",
    "verify:shader": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-shader.mjs",
    "build:sentence": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-sentence-atlas.mjs",
    "check:sentence": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-sentence-atlas.mjs --check",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:backend": "node scripts/py-tool.mjs pytest backend/",
    "test:scripts": "node --test scripts/*.test.mjs",
    "e2e": "npm run build && playwright test",
    "a11y": "npm run build && playwright test a11y.spec.ts",
    "lighthouse": "npm run build && npx --yes @lhci/cli@0.15.1 autorun",
    "lint": "eslint . --ext .ts,.html --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.html --fix",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss,json}\"",
    "lint:py": "node scripts/py-tool.mjs ruff check backend/ api/",
    "lint:py:fix": "node scripts/py-tool.mjs ruff check --fix backend/ api/",
    "format:py": "node scripts/py-tool.mjs ruff format backend/ api/",
    "format:py:check": "node scripts/py-tool.mjs ruff format --check backend/ api/",
    "typecheck:py": "node scripts/py-tool.mjs mypy",
    "check:docs": "node scripts/check-docs.mjs",
    "audit": "npm run audit:js && npm run audit:py",
    "audit:js": "npm audit --audit-level=high",
    "audit:py": "node scripts/py-tool.mjs pip-audit --strict --progress-spinner=off -r backend/requirements-dev.txt",
    "code-quality": "npm run format:check && npm run lint",
    "code-quality:py": "npm run format:py:check && npm run lint:py && npm run typecheck:py",
    "prepare": "husky",
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.html": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,json}": [
      "prettier --write"
    ],
    "*.py": [
      "node scripts/py-tool.mjs ruff check --fix",
      "node scripts/py-tool.mjs ruff format"
    ]
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0"
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "chart.js": "^4.5.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/build": "^22.0.5",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.0",
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
