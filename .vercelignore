# Vercel builds from source on its own runners, so the local build output and
# every test/lint artefact is dead weight in the upload. `.gitignore` does not
# apply to CLI deploys, so these have to be listed again here.

# Build output (Vercel runs `npm run build` itself)
dist
.angular

# Test and coverage artefacts
coverage
test-results
playwright-report
blob-report

# Python tooling caches and virtualenvs
__pycache__
.mypy_cache
.pytest_cache
.ruff_cache
backend/venv
backend/env
backend/ENV

# Local SQLite databases. The deployed function seeds its own throwaway copy in
# the temp directory (see api/index.py), so uploading a developer's local one
# would ship data nobody reviewed to a public URL and never even be read.
*.db

# Pyright config is editor tooling; nothing at runtime or build time reads it.
# pyproject.toml deliberately stays IN the upload despite also being tooling
# config: its `requires-python` is what pins the deployed interpreter. See the
# comment on that field.
pyrightconfig.json

# Local env files — the CLI writes VERCEL_OIDC_TOKEN into .env.local, and real
# values belong in Vercel's project env vars, never in the deployment upload.
.env
.env.*
